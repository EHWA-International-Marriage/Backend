# 로컬 실행: 이 파일을 .env로 복사해 값을 채운다. .env는 커밋 금지.

# MariaDB
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# JWT (시크릿은 Base64, 256bit 이상 / 만료는 밀리초)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=
JWT_REFRESH_EXPIRATION=

# AES 암호화 키 (Base64, 256bit)
AES_SECRET_KEY=

# Web
CORS_ORIGINS=
SITE_BASE_URL=
COOKIE_DOMAIN=
